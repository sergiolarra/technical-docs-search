# PostgreSQL
POSTGRES_DB=docsearch
POSTGRES_USER=docsearch
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/docsearch

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=docsearch
RABBITMQ_PASSWORD=changeme

# Backend
SERVER_PORT=8080
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=50MB
STORAGE_PATH=./uploads
MAX_EXTRACTED_CHARS=5000000
PROCESSING_CONCURRENCY=2
PROCESSING_MAX_CONCURRENCY=4
