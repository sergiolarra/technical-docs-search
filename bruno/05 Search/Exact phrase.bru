meta {
  name: Exact phrase
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/documents/search?q="arquitectura hexagonal"
  body: none
  auth: none
}

params:query {
  q: "arquitectura hexagonal"
}

tests {
  test("only documents with the consecutive words", function () {
    expect(res.getStatus()).to.equal(200);
    const titles = res.getBody().results.map(r => r.title);
    expect(titles).to.include("Guía de la API de documentos");
    expect(titles).to.not.include("Arquitectura de referencia");
  });
}
