meta {
  name: Empty file (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(samples/archivo-vacio.txt)
  title: Vacío
  author: QA
  category: Pruebas
  version: 1.0
}

tests {
  test("empty files are rejected", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().detail).to.equal("The file is empty");
  });
}
