meta {
  name: Missing title (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(samples/manual-despliegue.txt)
  author: Ana Pérez
  category: Backend
  version: 1.0
}

tests {
  test("returns a ProblemDetail with per-field errors", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(400);
    expect(body.title).to.equal("Validation failed");
    expect(body.errors).to.have.property("title");
  });
}
